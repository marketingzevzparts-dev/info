# Telegram bot token from @BotFather (for @zevs_Bid_bot)
TELEGRAM_BOT_TOKEN=

# Group chat_id to send notifications to.
# Get the exact value via https://api.telegram.org/bot<TOKEN>/getUpdates
# after adding the bot to the group and sending a message there.
# Supergroups usually need a -100 prefix, e.g. -1005593387996
TELEGRAM_CHAT_ID=

# KeyCRM pipeline (воронка) id to watch. Leave empty to react to all pipelines.
PIPELINE_ID=

# Optional: shared secret appended to the webhook URL as ?secret=...
# so KeyCRM's webhook endpoint can't be spammed by strangers.
WEBHOOK_SECRET=

# Optional: protects the /test-notify diagnostic route
ADMIN_KEY=

PORT=3000
